<Window x:Class="PdksMasaustu.Gorunumler.GirisPenceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:g="clr-namespace:PdksMasaustu.Gorunumler"
        Icon="/Varliklar/uygulama.ico"
        Title="{Binding Marka.UygulamaAdi, StringFormat='{}{0} · Giriş'}"
        Width="400" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">

    <StackPanel Margin="36,32">
        <!-- Logo: portal marka ayarından; yoksa (demo, ilk açılış çevrimdışı) genel simge -->
        <Image Source="{Binding Marka.Logo}" Height="140" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"
               Visibility="{Binding Marka.Logo, Converter={x:Static g:Donustur.NullDegilseGorunur}}" />
        <Border Width="64" Height="64" CornerRadius="32" HorizontalAlignment="Center"
                Background="{x:Static g:Gorunum.Yesil}"
                Visibility="{Binding Marka.Logo, Converter={x:Static g:Donustur.NullsaGorunur}}">
            <TextBlock Text="{x:Static g:Gorunum.IkonSaat}" FontFamily="{StaticResource IkonFont}"
                       FontSize="30" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="{Binding Marka.UygulamaAdi}" Style="{StaticResource Baslik}" HorizontalAlignment="Center" Margin="0,16,0,2" />
        <TextBlock Text="Personel giriş-çıkış ve mola takibi" Style="{StaticResource Soluk}" HorizontalAlignment="Center" />

        <Border Style="{StaticResource Rozet}" Background="{x:Static g:Gorunum.Turuncu}" HorizontalAlignment="Center" Margin="0,12,0,0"
                Visibility="{Binding DemoModu, Converter={x:Static g:Donustur.Gorunurluk}}">
            <TextBlock Text="Demo modu · herhangi bir bilgiyle giriş yapabilirsiniz" Foreground="White" FontSize="12" />
        </Border>

        <TextBlock Text="E-posta veya TC kimlik no" Margin="0,24,0,6" />
        <TextBox x:Name="KimlikKutusu" Text="{Binding Kimlik, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Text="Şifre" Margin="0,14,0,6" />
        <PasswordBox x:Name="SifreKutusu" />

        <TextBlock Text="{Binding Hata}" Foreground="{x:Static g:Gorunum.Kirmizi}" TextWrapping="Wrap" Margin="0,12,0,0"
                   Visibility="{Binding Hata, Converter={x:Static g:Donustur.DoluysaGorunur}}" />

        <Button x:Name="GirisButonu" Content="Giriş Yap" IsDefault="True" Margin="0,20,0,0" Height="40"
                HorizontalAlignment="Stretch" Style="{DynamicResource AccentButtonStyle}" Click="GirisButonu_Click" />
        <ProgressBar IsIndeterminate="True" Margin="0,10,0,0" Height="3"
                     Visibility="{Binding Mesgul, Converter={x:Static g:Donustur.Gorunurluk}}" />
        <TextBlock x:Name="SurumMetni" Style="{StaticResource Soluk}" FontSize="11" HorizontalAlignment="Center" Margin="0,16,0,0" />
    </StackPanel>
</Window>
