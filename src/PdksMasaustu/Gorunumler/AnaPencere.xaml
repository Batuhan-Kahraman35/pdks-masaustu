<Window x:Class="PdksMasaustu.Gorunumler.AnaPencere"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:g="clr-namespace:PdksMasaustu.Gorunumler"
        xmlns:m="clr-namespace:PdksMasaustu.Core.Modeller;assembly=PdksMasaustu.Core"
        Icon="/Varliklar/uygulama.ico"
        Title="{Binding Marka.UygulamaAdi}"
        Width="1000" Height="680" MinWidth="780" MinHeight="540"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Hareket satırı: hem "Bugün" listesinde hem ekip geçmişinde kullanılır -->
        <DataTemplate x:Key="HareketSablonu">
            <Grid Margin="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Zaman, Converter={x:Static g:Donustur.Saat}}" FontWeight="SemiBold"
                           FontSize="15" VerticalAlignment="Center" />
                <Border Grid.Column="1" Width="30" Height="30" CornerRadius="15"
                        Background="{Binding Tip, Converter={x:Static g:Donustur.TipRengi}}">
                    <TextBlock Text="{Binding Tip, Converter={x:Static g:Donustur.TipIkonu}}" FontFamily="{StaticResource IkonFont}"
                               FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                    <TextBlock Text="{Binding Tip, Converter={x:Static g:Donustur.TipMetni}}" VerticalAlignment="Center" />
                    <Border Style="{StaticResource Rozet}" Margin="10,0,0,0" Background="#33808080"
                            Visibility="{Binding Otomatik, Converter={x:Static g:Donustur.Gorunurluk}}"
                            ToolTip="Klavye/fare hareketsizliği nedeniyle son hareket saatiyle otomatik yazıldı">
                        <TextBlock Text="Otomatik" FontSize="11" />
                    </Border>
                    <TextBlock Text="{Binding Sube}" Style="{StaticResource Soluk}" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Ekip özet kutusu (tıklanınca listeyi o duruma süzer) -->
        <Style x:Key="OzetButonu" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Üst bilgi -->
        <Grid Margin="28,22,28,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Source="{Binding Marka.Logo}" Height="56" Margin="0,0,14,0" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   Visibility="{Binding Marka.Logo, Converter={x:Static g:Donustur.NullDegilseGorunur}}" />
            <StackPanel Grid.Column="1">
                <TextBlock Style="{StaticResource Baslik}">
                    <Run Text="Merhaba," /> <Run Text="{Binding PersonelAdi, Mode=OneWay}" />
                </TextBlock>
                <TextBlock x:Name="TarihMetni" Style="{StaticResource Soluk}" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border Style="{StaticResource Rozet}" Background="{x:Static g:Gorunum.Kirmizi}" Margin="0,0,10,0"
                        Visibility="{Binding Cevrimdisi, Converter={x:Static g:Donustur.Gorunurluk}}">
                    <TextBlock Text="Sunucuya ulaşılamıyor" Foreground="White" FontSize="12" />
                </Border>
                <Border Style="{StaticResource Rozet}" Background="{x:Static g:Gorunum.Turuncu}" Margin="0,0,10,0"
                        Visibility="{Binding DemoModu, Converter={x:Static g:Donustur.Gorunurluk}}">
                    <TextBlock Text="Demo" Foreground="White" FontSize="12" />
                </Border>
                <Button Command="{Binding YenileCommand}" ToolTip="Yenile" Padding="10,6">
                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IkonFont}" />
                </Button>
            </StackPanel>
        </Grid>

        <TabControl x:Name="Sekmeler" Grid.Row="1" Margin="20,8,20,8" SelectionChanged="Sekmeler_SelectionChanged">

            <!-- ============ BUGÜN ============ -->
            <TabItem Header="Bugün">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="330" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <!-- Durum kartı -->
                        <Border Style="{StaticResource Kart}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="52" Height="52" CornerRadius="26" VerticalAlignment="Top"
                                        Background="{Binding Durum, Converter={x:Static g:Donustur.DurumRengi}}">
                                    <TextBlock Text="{x:Static g:Gorunum.IkonSaat}" FontFamily="{StaticResource IkonFont}"
                                               FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DurumBasligi}" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding DurumAciklama}" Style="{StaticResource Soluk}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Eylemler -->
                        <Border Style="{StaticResource Kart}" Margin="0,12,0,0" Padding="20,20,20,12">
                            <StackPanel>
                                <Button Style="{StaticResource EylemButonu}" Command="{Binding GirisYapCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{x:Static g:Gorunum.IkonOynat}" FontFamily="{StaticResource IkonFont}" Foreground="{x:Static g:Gorunum.Yesil}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBlock Text="Giriş Yap" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource EylemButonu}" Command="{Binding MolayaCikCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{x:Static g:Gorunum.IkonDuraklat}" FontFamily="{StaticResource IkonFont}" Foreground="{x:Static g:Gorunum.Turuncu}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBlock Text="Molaya Çık" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource EylemButonu}" Command="{Binding MoladanDonCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{x:Static g:Gorunum.IkonOynat}" FontFamily="{StaticResource IkonFont}" Foreground="{x:Static g:Gorunum.Mavi}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBlock Text="Moladan Dön" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource EylemButonu}" Command="{Binding CikisYapCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{x:Static g:Gorunum.IkonKapat}" FontFamily="{StaticResource IkonFont}" Foreground="{x:Static g:Gorunum.Kirmizi}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBlock Text="Çıkış Yap" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="{Binding Mesaj}" TextWrapping="Wrap" Margin="0,4,0,4"
                                           Visibility="{Binding Mesaj, Converter={x:Static g:Donustur.DoluysaGorunur}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{x:Static g:Gorunum.Yesil}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MesajHata}" Value="True">
                                                    <Setter Property="Foreground" Value="{x:Static g:Gorunum.Kirmizi}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Gün özeti -->
                        <Border Style="{StaticResource Kart}" Margin="0,12,0,0">
                            <UniformGrid Columns="3">
                                <StackPanel>
                                    <TextBlock Text="İlk giriş" Style="{StaticResource Soluk}" FontSize="12" />
                                    <TextBlock Text="{Binding IlkGiris}" FontSize="17" FontWeight="SemiBold" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Çalışma" Style="{StaticResource Soluk}" FontSize="12" />
                                    <TextBlock Text="{Binding CalismaSuresi}" FontSize="17" FontWeight="SemiBold" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Mola" Style="{StaticResource Soluk}" FontSize="12" />
                                    <TextBlock Text="{Binding MolaSuresi}" FontSize="17" FontWeight="SemiBold" Margin="0,2,0,0" />
                                </StackPanel>
                            </UniformGrid>
                        </Border>
                    </StackPanel>

                    <!-- Bugünkü hareketler -->
                    <Border Grid.Column="2" Style="{StaticResource Kart}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Bugünkü hareketler" Style="{StaticResource AltBaslik}" />
                            <Grid>
                                <ItemsControl ItemsSource="{Binding Kayitlar}" ItemTemplate="{StaticResource HareketSablonu}" />
                                <TextBlock Text="Bugün henüz hareket yok." Style="{StaticResource Soluk}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding Kayitlar.Count, Converter={x:Static g:Donustur.SifirsaGorunur}}" />
                            </Grid>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============ EKİBİM ============ -->
            <TabItem x:Name="EkipSekmesi" Header="Ekibim" DataContext="{Binding Ekip}">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Özet kutuları -->
                    <UniformGrid Columns="4" Margin="0,0,-12,14">
                        <Button Style="{StaticResource OzetButonu}" Command="{Binding DurumaSuzCommand}" CommandParameter="{x:Static m:PersonelDurumu.Iceride}">
                            <StackPanel>
                                <TextBlock Text="{Binding Ozet.Iceride}" FontSize="26" FontWeight="SemiBold" Foreground="{x:Static g:Gorunum.Yesil}" />
                                <TextBlock Text="İçeride" Style="{StaticResource Soluk}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource OzetButonu}" Command="{Binding DurumaSuzCommand}" CommandParameter="{x:Static m:PersonelDurumu.Molada}">
                            <StackPanel>
                                <TextBlock Text="{Binding Ozet.Molada}" FontSize="26" FontWeight="SemiBold" Foreground="{x:Static g:Gorunum.Turuncu}" />
                                <TextBlock Text="Molada" Style="{StaticResource Soluk}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource OzetButonu}" Command="{Binding DurumaSuzCommand}" CommandParameter="{x:Static m:PersonelDurumu.Cikti}">
                            <StackPanel>
                                <TextBlock Text="{Binding Ozet.Cikti}" FontSize="26" FontWeight="SemiBold" Foreground="{x:Static g:Gorunum.Kirmizi}" />
                                <TextBlock Text="Çıkış yaptı" Style="{StaticResource Soluk}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource OzetButonu}" Command="{Binding DurumaSuzCommand}" CommandParameter="{x:Static m:PersonelDurumu.Gelmedi}">
                            <StackPanel>
                                <TextBlock Text="{Binding Ozet.Gelmedi}" FontSize="26" FontWeight="SemiBold" Foreground="{x:Static g:Gorunum.Gri}" />
                                <TextBlock Text="Gelmedi" Style="{StaticResource Soluk}" />
                            </StackPanel>
                        </Button>
                    </UniformGrid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="320" />
                        </Grid.ColumnDefinitions>

                        <!-- Personel listesi -->
                        <Border Style="{StaticResource Kart}" Padding="16">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid>
                                        <TextBox x:Name="AramaKutusu" Text="{Binding Arama, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="Ad veya departman ara…" Style="{StaticResource Soluk}" IsHitTestVisible="False"
                                                   VerticalAlignment="Center" Margin="12,0,0,0"
                                                   Visibility="{Binding Arama, Converter={x:Static g:Donustur.BossaGorunur}}" />
                                    </Grid>
                                    <TextBlock Grid.Column="1" Text="{Binding SonGuncelleme}" Style="{StaticResource Soluk}"
                                               FontSize="12" VerticalAlignment="Center" Margin="12,0" />
                                    <Button Grid.Column="2" Command="{Binding YenileCommand}" ToolTip="Yenile" Padding="10,6">
                                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IkonFont}" />
                                    </Button>
                                </Grid>
                                <TextBlock DockPanel.Dock="Top" Text="{Binding Hata}" Foreground="{x:Static g:Gorunum.Kirmizi}" Margin="0,0,0,8"
                                           Visibility="{Binding Hata, Converter={x:Static g:Donustur.DoluysaGorunur}}" />
                                <!-- Sekme herkese açık; bağlı personeli olmayan kullanıcı listeyi boş görür -->
                                <StackPanel DockPanel.Dock="Top" Margin="0,24,0,0" HorizontalAlignment="Center"
                                            Visibility="{Binding EkipBos, Converter={x:Static g:Donustur.Gorunurluk}}">
                                    <TextBlock Text="&#xE716;" FontFamily="{StaticResource IkonFont}" FontSize="32"
                                               Style="{StaticResource Soluk}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Size bağlı personel bulunmuyor." FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,4" />
                                    <TextBlock Text="Ekip, personel kartındaki Üst Yönetici alanına göre oluşur." Style="{StaticResource Soluk}"
                                               HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                                </StackPanel>
                                <DataGrid ItemsSource="{Binding PersonelGorunumu}" SelectedItem="{Binding SeciliUye}"
                                          Visibility="{Binding EkipBos, Converter={x:Static g:Donustur.TersGorunurluk}}"
                                          AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                          GridLinesVisibility="None" SelectionMode="Single" CanUserResizeRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Personel" Binding="{Binding AdSoyad}" Width="2*" />
                                        <DataGridTextColumn Header="Departman" Binding="{Binding Departman}" Width="*" />
                                        <DataGridTemplateColumn Header="Durum" Width="*" SortMemberPath="Durum">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource Rozet}" Background="{Binding Durum, Converter={x:Static g:Donustur.DurumRengi}}">
                                                        <TextBlock Text="{Binding Durum, Converter={x:Static g:Donustur.DurumMetni}}" Foreground="White" FontSize="12" />
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Son hareket" Width="*" SortMemberPath="SonZaman">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding SonZaman, Converter={x:Static g:Donustur.Saat}}" FontWeight="SemiBold" />
                                                        <TextBlock Text=" ●" Foreground="{x:Static g:Gorunum.Gri}"
                                                                   ToolTip="Otomatik kayıt" Visibility="{Binding SonOtomatik, Converter={x:Static g:Donustur.Gorunurluk}}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="İlk giriş" Binding="{Binding IlkGiris, Converter={x:Static g:Donustur.Saat}}" Width="Auto" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>

                        <!-- Seçili personelin günü -->
                        <Border Grid.Column="2" Style="{StaticResource Kart}">
                            <Grid>
                                <TextBlock Text="Ayrıntı için listeden bir personel seçin." Style="{StaticResource Soluk}" TextWrapping="Wrap"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                           Visibility="{Binding SeciliUye, Converter={x:Static g:Donustur.NullsaGorunur}}" />
                                <DockPanel Visibility="{Binding SeciliUye, Converter={x:Static g:Donustur.NullDegilseGorunur}}">
                                    <StackPanel DockPanel.Dock="Top">
                                        <TextBlock Text="{Binding SeciliUye.AdSoyad}" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding SeciliUye.Departman}" Style="{StaticResource Soluk}" Margin="0,2,0,12" />
                                        <DatePicker x:Name="TarihSecici" SelectedDate="{Binding SeciliTarih}" />
                                        <TextBlock Text="{Binding GecmisOzeti}" Style="{StaticResource Soluk}" Margin="0,10,0,6" />
                                    </StackPanel>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding Gecmis}" ItemTemplate="{StaticResource HareketSablonu}" />
                                    </ScrollViewer>
                                </DockPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Alt bilgi -->
        <Grid Grid.Row="2" Margin="28,0,28,12">
            <TextBlock Style="{StaticResource Soluk}" FontSize="12"
                       Text="Pencereyi kapatmak uygulamayı kapatmaz; takip sistem tepsisinde sürer." />
            <TextBlock Text="{Binding Surum}" Style="{StaticResource Soluk}" FontSize="12" HorizontalAlignment="Right" />
        </Grid>
    </Grid>
</Window>
