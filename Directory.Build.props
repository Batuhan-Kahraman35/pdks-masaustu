<Project>
  <!-- Tüm projeler için ortak ayarlar. Sürüm yalnız buradan değişir; Velopack paketi de bu değeri kullanır. -->
  <PropertyGroup>
    <Version>0.1.3</Version>
    <Authors>Batuhan KAHRAMAN</Authors>
    <Product>PDKS Masaüstü</Product>
    <Copyright>© 2026 Batuhan KAHRAMAN</Copyright>
    <RepositoryUrl>https://github.com/Batuhan-Kahraman35/pdks-masaustu</RepositoryUrl>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>
</Project>
